# Cloudflare Pages / Workers routing configuration
# SPA (Single Page Application) - all routes redirect to index.html

# Redirect all routes to index.html (except for static assets)
/* /index.html 200

# Static assets - cache for 1 year
/assets/* /assets/:splat 200 cache=31536000

# Manifest dan service worker - cache untuk 24 jam dengan versioning
/manifest.json /manifest.json 200 cache=86400
/service-worker.js /service-worker.js 200 cache=3600

# CSS dan JS files - cache dengan busting
/assets/css/* /assets/css/:splat 200 cache=31536000
/assets/js/* /assets/js/:splat 200 cache=31536000
/assets/img/* /assets/img/:splat 200 cache=31536000

# HTML files - no cache (force fresh)
/*.html /:splat.html 200
/auth/*.html /auth/:splat.html 200

# Specific pages - no cache
/index.html /index.html 200 cache=no-cache
/admin.html /admin.html 200 cache=no-cache
/login.html /login.html 200 cache=no-cache
/register.html /register.html 200 cache=no-cache

# Fallback untuk semua route yang tidak match
/* /index.html 200
